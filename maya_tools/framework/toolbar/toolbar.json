{
  "version": 1,
  "groups": [
    {"id": "brandmark", "zone": "logo", "label": "Brand", "items": [
      {"type": "MenuButton", "id": "fs_about", "glyph": "Bridge", "icon": "fs_bridge.png",
       "width": 100,
       "title": "Bridge",
       "annotation": "maya_tools.framework.toolbar.popovers:about_annotation",
       "tooltip": "Click for About (version + license). Right-click for Tutorials, Help, and File a Bug.",
       "command": "maya_tools.framework.toolbar.popovers:show_about_card",
       "menu_factory": "maya_tools.framework.toolbar.popovers:about_menu"},
      {"type": "ProjectChooser", "id": "project_chooser", "glyph": "PRJ", "title": "Project",
       "tooltip": "Active project (stored in toolbar prefs)"},
      {"type": "IconButton", "id": "project_setup", "glyph": "PST", "icon": "fs_projectsetup.png",
       "title": "Project Setup", "doc": "project-setup",
       "command": "maya_tools.framework.project_setup_ui:ProjectSetupUI.show_window"}
    ]},
    {"id": "armature", "zone": "left", "label": "Armature", "items": [
      {"type": "WindowLauncher", "id": "armature_import", "glyph": "ARMA",
       "icon": "fs_armature_icon.png", "title": "Armature Import",
       "tooltip": "Import an Armature USD export: mesh, skeleton and skin weights come in from the file, the Fabricator blueprint is built and loaded, ready for Build Rig. Import into an empty scene.",
       "command": "maya_tools.rigging.armature_import.armature_import_ui:ArmatureImportWindow.show_window"}
    ]},
    {"id": "io", "zone": "left", "label": "Scene", "items": [
      {"type": "RenamerInline", "id": "renamer", "glyph": "REN", "doc": "renamer"},
      {"type": "MenuButton", "id": "scene", "glyph": "SCN", "icon": "fs_folder.png",
       "title": "Scene Tools",
       "tooltip": "Save, open, and reload scenes; hop between Rig and Source siblings. Right-click for options.",
       "menu_factory": "maya_tools.framework.toolbar.popovers:scene_menu"},
      {"type": "PopoverButton", "id": "export", "glyph": "EXP", "icon": "fs_export.png", "doc": "exporter",
       "title": "Export", "trigger": "click",
       "popover": "maya_tools.framework.toolbar.popovers:ExportPopover"},
      {"type": "MenuButton", "id": "clipboard", "glyph": "CLP", "icon": "fs_clipboard.png",
       "title": "Clipboard Tools",
       "tooltip": "Copy selected node names, the scene name, its folder, or its full path to the clipboard. Right-click for options.",
       "menu_factory": "maya_tools.framework.toolbar.popovers:clipboard_menu"}
    ]},
    {"id": "build", "zone": "left_center", "label": "Build", "items": [
      {"type": "MenuButton", "id": "create", "glyph": "CR", "icon": "fs_create.png",
       "title": "Create Objects",
       "tooltip": "Right-click for options.",
       "menu_factory": "maya_tools.framework.toolbar.popovers:create_menu"},
      {"type": "MenuButton", "id": "select_helpers", "glyph": "SEL", "icon": "fs_select.png",
       "title": "Selection Helpers",
       "tooltip": "Right-click for options.",
       "menu_factory": "maya_tools.framework.toolbar.popovers:select_menu"},
      {"type": "MenuButton", "id": "mirror", "glyph": "MIR", "icon": "fs_mirror.png",
       "title": "Mirror Helpers",
       "tooltip": "Mirror joints, skin weights, or ctrl curves to the opposite side. Right-click for options.",
       "menu_factory": "maya_tools.framework.toolbar.popovers:mirror_menu"},
      {"type": "MenuButton", "id": "snap_ab", "glyph": "SNP", "icon": "fs_snap.png",
       "title": "Snap A to B",
       "tooltip": "Snap A to B (position). Right-click for match-transform options.",
       "command": "maya_tools.framework.toolbar.toolbar_commands:snap_position_only",
       "menu_factory": "maya_tools.framework.toolbar.popovers:snap_menu"}
    ]},
    {"id": "rigging", "zone": "center", "label": "Rig", "items": [
      {"type": "MenuButton", "id": "skeleton", "glyph": "SKL", "icon": "fs_skeleton.png",
       "title": "Skeleton Tools",
       "tooltip": "Assortment of Skeleton Tools. Left-click to open Skeleton IO. Right-click for options.",
       "command": "maya_tools.skeleton.skeleton_io.skeleton_io_ui:SkeletonIOWindow.show_window",
       "menu_factory": "maya_tools.framework.toolbar.popovers:skeleton_menu"},
      {"type": "MenuButton", "id": "skin", "glyph": "SKN", "icon": "fs_skin.png",
       "title": "Skin Tools",
       "tooltip": "Assortment of Skin Tools. Left-click to open Skin IO. Right-click for options.",
       "command": "maya_tools.skinning.skin_io.skin_io_ui:SkinIOWindow.show_window",
       "menu_factory": "maya_tools.framework.toolbar.popovers:skin_menu"},
      {"type": "FabricatorButton", "id": "fabricator", "glyph": "FAB", "icon": "fs_fabricator.png",
       "title": "Fabricator", "doc": "fabricator",
       "tooltip": "Click: open docked. Double-click: open floating. Right-click: Build / Unbuild.",
       "command": "maya_tools.rigging.fabricator.ui.fabricator_dock:open_docked",
       "double_command": "maya_tools.rigging.fabricator.ui.fs_window:FSWindow.show_window",
       "menu_factory": "maya_tools.framework.toolbar.popovers:fabricator_build_menu"},
      {"type": "PopoverButton", "id": "curve_o_matic", "glyph": "COM", "icon": "fs_curveomatic.png",
       "title": "CtrlEditor", "trigger": "click", "doc": "ctrl-editor",
       "popover": "maya_tools.framework.toolbar.popovers:CurveOMaticPopover"},
      {"type": "PopoverButton", "id": "library", "glyph": "LIB", "icon": "fs_animlibrary.png",
       "title": "Pose & Anim Studios", "trigger": "click", "doc": "pose-anim-studio",
       "tooltip": "Left-click to open the Pose & Anim Studios. Right-click for options.",
       "menu": [
         {"label": "Mirror Pose",
          "command": "maya_tools.animation.anim_helpers.anim_helpers_app:mirror_pose"}
       ],
       "popover": "maya_tools.framework.toolbar.popovers:LibraryPopover"}
    ]},
    {"id": "skin_row", "zone": "right_center", "label": "Skin", "items": [
      {"type": "Cluster", "id": "influence", "items": [
        {"type": "IconButton", "id": "add_influence", "glyph": "+",
         "icon": "fs_add_influence.png",
         "title": "Add Influence",
         "tooltip": "Add selected influence(s) to mesh (weight 0, locked)",
         "command": "maya_tools.framework.toolbar.toolbar_commands:add_influence_from_selected"},
        {"type": "IconButton", "id": "remove_influence", "glyph": "-",
         "icon": "fs_remove_influence.png",
         "title": "Remove Influence",
         "tooltip": "Remove selected influence",
         "command": "maya_tools.framework.toolbar.toolbar_commands:remove_influence"}
      ]},
      {"type": "PopoverButton", "id": "smoosh", "glyph": "SM", "icon": "fs_skin_smoosh.png",
       "title": "Smoosh", "trigger": "hover",
       "popover": "maya_tools.framework.toolbar.popovers:SmooshPopover",
       "command": "maya_tools.framework.toolbar.toolbar_commands:smoosh_click"},
      {"type": "Cluster", "id": "weights", "items": [
        {"type": "IconButton", "id": "copy_weights", "glyph": "CW", "icon": "fs_copy_weights.png",
         "title": "Copy Weights",
         "tooltip": "Copy weights from selected vert(s)",
         "command": "maya_tools.skinning.weight_clipboard:record_weights"},
        {"type": "IconButton", "id": "paste_weights", "glyph": "PW", "icon": "fs_paste_weights.png",
         "title": "Paste Weights",
         "tooltip": "Paste weights onto selected verts",
         "command": "maya_tools.skinning.weight_clipboard:paste_weights"},
        {"type": "IconButton", "id": "avg_weights", "glyph": "AVG", "icon": "fs_average_weights.png",
         "title": "Average Weights",
         "tooltip": "Average weights across selected verts",
         "command": "maya_tools.skinning.weight_clipboard:average_weights"}
      ]},
      {"type": "Toggle", "id": "paint_on_select", "glyph": "PNT",
       "label": "Paint Weights", "width": 118, "height": 26,
       "title": "Paint on Select",
       "tooltip": "Select a mesh to automatically launch the Paint Weights tool. Turn off to stop this behavior.",
       "command": "maya_tools.framework.toolbar.toolbar_commands:toggle_paint_on_select",
       "state_query": "maya_tools.framework.toolbar.toolbar_commands:paint_on_select_enabled"}
    ]},
    {"id": "config", "zone": "settings", "label": "Settings", "items": [
      {"type": "IconButton", "id": "reggie", "glyph": "Reggie",
       "icon": "fs_aita.png",
       "width": 70,
       "doc": "reggie",
       "tooltip": "Click to dock Reggie in.",
       "command": "maya_tools.framework.toolbar.reggie.reggie_dock:open_docked"},
      {"type": "MenuButton", "id": "settings", "glyph": "SET", "icon": "fs_settings_tools.png",
       "title": "Settings", "doc": "settings",
       "tooltip": "Settings: bind this machine's project roots. Right-click for quick toolbar options.",
       "command": "maya_tools.framework.settings_ui:SettingsUI.show_window",
       "menu_factory": "maya_tools.framework.toolbar.popovers:settings_menu"}
    ]}
  ]
}
